# ClaudeOS Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# Anthropic API key — required for Claude Code and any AI tooling
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=

# GitHub personal access token — required for the GitHub MCP server
# Needs scopes: repo, read:org
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=
